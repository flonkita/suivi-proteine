generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  
}

// On ajoute les objectifs possibles
enum UserGoal {
  GENERAL_HEALTH     // "Remise en forme / Santé"
  MUSCLE_GAIN        // "Prise de masse"
  ATHLETIC           // "Performance athlétique (Ton mode actuel !)"
}

model UserProfile {
  id           String   @id @default(uuid())
  deviceId     String   @unique // NOUVEAU : Le badge unique du téléphone
  startWeight  Float
  name         String?
  targetWeight Float
  targetMonths Int      @default(4)
  goal         UserGoal @default(GENERAL_HEALTH)
  isPremium    Boolean  @default(true) // NOUVEAU : On peut gérer les comptes premium pour les tests
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // NOUVEAU : Relation avec ses propres jours de suivi
  dailyTrackings DailyTracking[]
}

model DailyTracking {
  id            String   @id @default(uuid())
  date          DateTime
  weight        Float?
  waterIntake   Int      @default(0)
  isTrainingDay Boolean  @default(false)
  meals         Meal[]
  createdAt     DateTime @default(now())

  // NOUVEAU : Lien vers le profil du testeur
  userProfileId String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id])

  // NOUVEAU : On empêche les doublons pour UN utilisateur sur UNE date
  @@unique([date, userProfileId]) 
}

// Table pour les repas
model Meal {
  id              String        @id @default(uuid())
  type            MealType      
  foodItems       String        
  calories        Int?          
  protein         Int?          
  carbs           Int?          // NOUVEAU : Glucides en grammes
  fats            Int?          // NOUVEAU : Lipides en grammes
  isCompliant     Boolean       @default(true) 
  comment         String?      
  dailyTrackingId String
  dailyTracking   DailyTracking @relation(fields: [dailyTrackingId], references: [id])
  createdAt       DateTime      @default(now())
}

// Les 4 moments de repas définis par ton protocole
enum MealType {
  PETIT_DEJEUNER
  DEJEUNER
  COLLATION
  DINER
}

